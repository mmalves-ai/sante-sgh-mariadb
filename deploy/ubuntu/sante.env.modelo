# Arquivo de ambiente do servidor de aplicação: /etc/sante-sgh/sante.env (0600, dono o usuário do serviço).
# Gerado por pnpm instalacao:gerar (tools/instalacao); não edite o modelo à mão.
# Troque todo <preencher> e todo <gerar>; a conferência recusa o arquivo que ainda os tenha.
# Nenhum segredo vai para o repositório: este modelo só tem marcadores.

# ── Produto, rede e endereços ───────────────────────────────────────────────────────────────────────────

# Ambiente da instalação. (OBRIGATÓRIA; valores: producao, homolog, treino)
AMBIENTE=producao

# Nome do produto exibido nas telas e documentos (DP-49). (OBRIGATÓRIA)
PRODUTO_NOME=<preencher>

# Código do pacote de marca da rede nos documentos e e-mails (letras minúsculas, dígitos e hífen; padrão: rede-sante). (recomendada)
MARCA=<preencher>

# Código da rede (minúsculas, dígitos e hífen). (OBRIGATÓRIA)
REDE_PADRAO=<preencher>

# Domínio base: a rede é resolvida pelo endereço de acesso. (OBRIGATÓRIA)
DOMINIO_BASE=<preencher>

# Nome do servidor ligado à rede, nome=rede (vários com ;); o do --dominio, salvo <rede>.<DOMINIO_BASE>. (opcional)
# REDE_ENDERECOS=

# Endereço público https das telas (links dos e-mails). (OBRIGATÓRIA)
WEB_ENDERECO=<preencher>

# Endereço público do portal do paciente, se diferente do das telas. (opcional)
# PORTAL_ENDERECO=

# Endereço https do verificador público dos documentos. (OBRIGATÓRIA)
DOCUMENTO_URL_VALIDACAO=<preencher>

# Endereço do BI externo, quando houver. (opcional)
# BI_ENDERECO=

# Cliente usado quando a requisição não traz o cliente (instalação com um só cliente). (opcional)
# CLIENTE_PADRAO=

# ── Banco de cada estabelecimento e conexões ────────────────────────────────────────────────────────────

# Códigos dos estabelecimentos deste servidor, separados por vírgula. (OBRIGATÓRIA)
ESTABELECIMENTOS=pc

# Estabelecimentos que entram no índice de pacientes da rede. (opcional)
# REDE_MPI_ESTABELECIMENTOS=

# Servidor do MariaDB dos bancos dos clientes e da plataforma (nome ou endereço). (OBRIGATÓRIA)
SGH_MARIADB_HOST=<preencher>

# Conta da aplicação no MariaDB, com o papel_aplicacao como papel padrão (anexos de privilégios do manual). (OBRIGATÓRIA)
SGH_MARIADB_USUARIO=<preencher>

# Senha da conta da aplicação no MariaDB (definida pela TI ao criar a conta). (OBRIGATÓRIA; SEGREDO)
MARIADB_SENHA=<gerar>

# Conta que aplica as migrações (DDL) dos bancos; vazio: as migrações não rodam pela aplicação. (opcional)
# SGH_MARIADB_USUARIO_MIGRACOES=

# Nome do banco da plataforma (clientes, credenciais e fila do conector). Vazio: plataforma. (opcional)
# SGH_BANCO_PLATAFORMA=

# Série por estabelecimento: FB_<CÓDIGO>_<CAMPO>, uma para cada código de ESTABELECIMENTOS (exemplo: pc).
# Três contas, todas com autenticação Srp: aplicação (papel SGH_APLICACAO), scripts (dona dos objetos SGH_) e leitura.

# Nome de exibição do estabelecimento. (OBRIGATÓRIA)
FB_PC_NOME=<preencher>

# Servidor do banco (nome ou endereço; com túnel, 127.0.0.1 e a porta local do túnel). (OBRIGATÓRIA)
FB_PC_HOST=<preencher>

# Porta do Firebird (ou a porta local do túnel). (OBRIGATÓRIA)
FB_PC_PORTA=3050

# Caminho do banco no servidor do banco, ou o apelido do databases.conf. (OBRIGATÓRIA)
FB_PC_BANCO=<preencher>

# Conta da APLICAÇÃO, com o papel SGH_APLICACAO (nunca SYSDBA). (OBRIGATÓRIA)
FB_PC_USUARIO=SGH_APP

# Senha da conta da aplicação. (OBRIGATÓRIA; SEGREDO)
FB_PC_SENHA=<gerar>

# Conta de SCRIPTS, dona dos objetos SGH_ (só a migração a usa). (OBRIGATÓRIA)
FB_PC_SCRIPTS_USUARIO=SGH_SCRIPTS

# Senha da conta de scripts (pode ficar fora do arquivo e ser informada só na hora da migração). (OBRIGATÓRIA; SEGREDO)
FB_PC_SCRIPTS_SENHA=<gerar>

# Conta de LEITURA, para a simulação da migração e a fumaça pós-implantação. (OBRIGATÓRIA)
FB_PC_LEITURA_USUARIO=SGH_LEITURA

# Senha da conta de leitura. (OBRIGATÓRIA; SEGREDO)
FB_PC_LEITURA_SENHA=<gerar>

# ── Serviços do servidor (portas, fila, documentos) ─────────────────────────────────────────────────────

# Porta local da API (só 127.0.0.1; o nginx encaminha /api). Fixada pelo pacote: só vazia ou 3300. (opcional)
API_PORTA=3300

# Fila e cache (Valkey local do servidor). (OBRIGATÓRIA)
VALKEY_URL=redis://127.0.0.1:6379

# Prefixo das filas (só quando dois ambientes dividem o Valkey). (opcional)
# FILAS_PREFIXO=

# Conversor de documentos para PDF. (recomendada)
GOTENBERG_URL=http://127.0.0.1:3000

# Lista dos serviços do worker (vazio: todos). (opcional)
# WORKER_SERVICOS=

# Intervalo do sinal de vida do worker, em ms. (opcional)
# WORKER_SINAL_MS=

# Clientes atendidos pelos ciclos do worker, separados por vírgula (vazio: os clientes em uso na plataforma). (opcional)
# WORKER_CLIENTES=

# Nível dos logs. (opcional; valores: fatal, error, warn, info, debug, trace)
LOG_NIVEL=info

# Fuso dos processos: sempre UTC (o banco guarda a hora local e o sistema converte; as telas mostram a hora de Brasília). (OBRIGATÓRIA; valores: UTC)
TZ=UTC

# Módulos da API ligados: todos ou a lista separada por vírgula. (opcional)
API_MODULOS=todos

# ── Segurança, chaves e sessão ──────────────────────────────────────────────────────────────────────────

# Chave mestra (32 bytes em base64): segundo fator, selos e cifras. (OBRIGATÓRIA; SEGREDO; gere com: openssl rand -base64 32)
PLATAFORMA_CHAVE_MESTRA=<gerar>

# Chave própria do envelope da credencial forte e do segundo fator do login (32 bytes em base64; padrão: a mestra). Nunca troque depois do uso. (opcional; SEGREDO; gere com: openssl rand -base64 32)
# ACESSO_CHAVE_MESTRA=

# Chave do pseudônimo do paciente no data mart (HMAC). Sem ela, fora de dev, a carga diária falha. Nunca troque depois do uso. (OBRIGATÓRIA; SEGREDO; gere com: openssl rand -base64 32)
DATA_MART_CHAVE=<gerar>

# Chave do pseudônimo dos pacotes de dados entregues aos parceiros. Nunca troque depois do uso. (opcional; SEGREDO; gere com: openssl rand -base64 32)
# PACOTES_PARCEIRO_CHAVE_PSEUDONIMO=

# Chave própria do portal (32 bytes em base64; padrão: a mestra). (opcional; SEGREDO; gere com: openssl rand -base64 32)
# PORTAL_CHAVE_MESTRA=

# Chave da cifra do CPF dos colaboradores (padrão: a mestra). Nunca troque depois do uso. (recomendada; SEGREDO; gere com: openssl rand -base64 32)
PESSOAS_CHAVE_CPF=<gerar>

# Rótulo do atendimento da plataforma na trilha. (opcional)
# PLATAFORMA_EM_NOME_DE=

# Minutos de bloqueio após tentativas de login erradas. (opcional)
# ACESSO_BLOQUEIO_PORTA_MINUTOS=

# Duração do acesso de emergência, em minutos. (opcional)
# ACESSO_EMERGENCIA_MINUTOS=

# Duração da sessão de suporte, em minutos. (opcional)
# SUPORTE_SESSAO_MINUTOS=

# nao: desliga o aviso ao auditor nas sessões de suporte. (opcional; valores: sim, nao)
# SUPORTE_AVISO_AUDITOR=

# Como a estação entra na trilha. (opcional)
# TRILHA_ESTACAO=

# Pasta do cofre dos certificados (0700, dono o usuário do serviço). (opcional)
COFRE_DIR=/var/lib/sante-sgh/cofre

# Certificado da impressão local (QZ Tray). (opcional)
# QZ_CERTIFICADO_ARQUIVO=

# Chave privada da impressão local (arquivo 0600). (opcional)
# QZ_CHAVE_PRIVADA_ARQUIVO=

# Estabelecimentos (códigos separados por vírgula) em que o aviso de contas sem uso roda. (opcional)
# ACESSO_CONTAS_DORMENTES_ESTABELECIMENTOS=

# ── E-mail e destinatários de aviso ─────────────────────────────────────────────────────────────────────

# Servidor de e-mail (smtps://conta:senha@host:465). (OBRIGATÓRIA; SEGREDO)
SMTP_URL=<gerar>

# Remetente dos e-mails do sistema. (OBRIGATÓRIA)
EMAIL_REMETENTE=<preencher>

# Destino dos avisos de auditoria. (recomendada)
AUDITORIA_EMAIL=<preencher>

# Destino do alerta quando o dono do relatório não tem e-mail. (opcional)
# ALERTA_RELATORIO_EMAIL=

# Servidor SMTP de saída. Fora de produção só é aceito destino local (neutralização). (opcional)
# SMTP_HOST=

# ── Armazenamento de arquivos (disco da máquina, ADR 0004) ──────────────────────────────────────────────

# Pasta absoluta dos arquivos (uma subpasta por banco de cliente), no disco da máquina; ex.: /srv/sante-sgh/arquivos. Cópia de segurança pela hospedagem (snapshot do volume ou backup do cliente). (OBRIGATÓRIA)
ARQUIVOS_RAIZ=<preencher>

# Alerta (instalação e vigia do worker) quando o espaço livre da pasta de arquivos fica abaixo deste valor, em GB. (opcional)
ARQUIVOS_ALERTA_LIVRE_GB=20

# Dias de retenção dos documentos de prova. (opcional)
# DOCUMENTO_RETENCAO_DIAS=

# ── Integrações externas ────────────────────────────────────────────────────────────────────────────────

# Motor de integração (HL7) do hospital. (opcional)
# OIE_URL=

# Servidor MLLP do motor de integração. (opcional)
# OIE_MLLP_HOST=

# Modo da assinatura ICP-Brasil (vazio: desligada com motivo). (recomendada)
ASSINATURA_ICP_MODO=

# Carimbo do tempo (ACT). (opcional)
# ASSINATURA_ACT_URL=

# Agente local de assinatura das estações. (opcional)
# ASSINATURA_AGENTE_LOCAL_URL=

# Retorno da assinatura em nuvem. (opcional)
# ASSINATURA_RETORNO_URL=

# Política AD-RB da assinatura. (opcional)
# ASSINATURA_POLITICA_AD_RB=

# Política AD-RT da assinatura. (opcional)
# ASSINATURA_POLITICA_AD_RT=

# Reprocessamento das assinaturas pendentes. (opcional; valores: ligado, desligado)
# ASSINATURA_REPROCESSAR=

# Intervalo do reprocessamento das assinaturas, em ms. (opcional)
# ASSINATURA_REPROCESSAR_MS=

# Pasta das raízes ICP-Brasil. (opcional)
# ICP_RAIZES_DIR=

# Pasta das intermediárias ICP-Brasil. (opcional)
# ICP_INTERMEDIARIAS_DIR=

# Modo do PACS (vazio: desligado com motivo). (opcional)
# PACS_MODO=

# Modo do pagamento no portal (vazio: desligado). (opcional)
# PORTAL_PAGAMENTO_MODO=

# Provedor da teleconsulta (vazio: desligado). (opcional)
# TELECONSULTA_PROVEDOR_MODO=

# sim: autoriza o envio à RNDS de homologação. (opcional)
# RNDS_HOMOLOGACAO_AUTORIZADA=

# Certificado ICP-Brasil (e-CNPJ A1) do estabelecimento para a RNDS; vazio: o RIA não sai para a homologação nem para a produção (dev e ci usam sempre o simulador). (opcional)
# RNDS_CERTIFICADO_PFX=

# Pasta do XSD da TISS (padrão: o do pacote). (opcional)
# TISS_XSD_PASTA=

# Pasta dos XSD do eSocial, uma subpasta por leiaute (padrão: o do pacote). (opcional)
# ESOCIAL_XSD_PASTA=

# producao: envia os lotes ao serviço do eSocial (só com AMBIENTE=producao e o certificado); vazio ou coletor: coletor local. (opcional)
# ESOCIAL_MODO=

# Certificado e-CNPJ (A1) do transmissor do eSocial em PEM, no cofre (convertido do .pfx na implantação). (opcional)
# ESOCIAL_CERTIFICADO_ARQUIVO=

# Chave privada do certificado do eSocial em PEM (arquivo 0600, no cofre). (opcional)
# ESOCIAL_CHAVE_ARQUIVO=

# Senha da chave do certificado do eSocial. (opcional; SEGREDO)
# ESOCIAL_CHAVE_SENHA=

# Endereço do serviço de envio do eSocial (padrão: o oficial de produção). (opcional)
# ESOCIAL_ENVIO_URL=

# Endereço do serviço de consulta do eSocial (padrão: o oficial de produção). (opcional)
# ESOCIAL_CONSULTA_URL=

# 1: envia a NF-e de saída à SEFAZ (só com AMBIENTE=producao e o certificado); vazio: o simulador local. (opcional)
# NFE_SEFAZ_LIGADA=

# Certificado e-CNPJ (A1) da NF-e em PEM, no cofre (convertido do .pfx na implantação). (opcional)
# NFE_CERTIFICADO_ARQUIVO=

# Chave privada do certificado da NF-e em PEM (arquivo 0600, no cofre). (opcional)
# NFE_CHAVE_ARQUIVO=

# Senha da chave do certificado da NF-e. (opcional; SEGREDO)
# NFE_CHAVE_SENHA=

# Clientes cujo ciclo de integração o worker roda (separados por vírgula). Vazio: os ativos da plataforma. (opcional)
# INTEGRACAO_CLIENTES=

# ── Rotinas do worker (ligar, desligar, intervalos) ─────────────────────────────────────────────────────

# Vigia de integridade dos arquivos (hash x registro). (opcional; valores: desligado)
# VIGIA_ARQUIVOS=

# Intervalo do vigia dos arquivos, em ms (padrão 6 h). (opcional)
# VIGIA_ARQUIVOS_MS=

# Envio da caixa de saída (e-mails, avisos e integrações). Vazio: o padrão do ambiente. (opcional)
# OUTBOX_RELAY=

# Transmissor TISS da elegibilidade e da comunicação de beneficiário (destino falso fora de produção). Vazio: o padrão do ambiente. (opcional)
# TRANSMISSOR_TISS=

# Entrega dos pedidos aos equipamentos do laboratório e recolhimento do resultado (simulador fora de produção). Vazio: o padrão do ambiente. (opcional)
# ENTREGA_EQUIPAMENTO=

# Integrações de saída do worker. Vazio: o padrão do ambiente. (opcional)
# INTEGRACAO=

# Vigia do banco (transações, travas e conexões; desligado desliga). Vazio: o padrão do ambiente. (opcional)
# VIGIA_BANCO=

# Envio agendado de relatórios. Vazio: o padrão do ambiente. (opcional)
# RELATORIO_ENVIO=

# Envio dos relatórios agendados vencidos ao subir. Vazio: o padrão do ambiente. (opcional)
# RELATORIO_ENVIO_VENCIDOS=

# Índice de busca de pacientes. Vazio: o padrão do ambiente. (opcional)
# BUSCA_VIGIA=

# Publicação dos catálogos. Vazio: o padrão do ambiente. (opcional)
# CATALOGO_PUBLICADOR=

# Fechamento diário do censo. Vazio: o padrão do ambiente. (opcional)
# CENSO_FECHAMENTO=

# Aviso de estouro do tempo da classificação de risco. Vazio: o padrão do ambiente. (opcional)
# CLASSIFICACAO_ESTOURO=

# Leitura dos fatos contábeis dos módulos. Vazio: o padrão do ambiente. (opcional)
# CONTABIL_LEITURA=

# Contabilização dos fatos lidos em lançamentos automáticos (desligado: só lê). Vazio: o padrão do ambiente. (opcional)
# CONTABIL_CONTABILIZAR=

# Folha de contingência da enfermagem por hora. Vazio: o padrão do ambiente. (opcional)
# CONTINGENCIA_POR_HORA=

# Expiração das reservas de leito. Vazio: o padrão do ambiente. (opcional)
# NIR_EXPIRACAO=

# Lista de trabalho do PACS. Vazio: o padrão do ambiente. (opcional)
# PACS_WORKLIST=

# Conferência diária dos conselhos profissionais. Vazio: o padrão do ambiente. (opcional)
# PESSOAS_CONSELHO_DIARIO=

# Alerta diário de vencimento dos contratos com fornecedores. Vazio: o padrão do ambiente. (opcional)
# CONTRATOS_ALERTA_DIARIO=

# Efetivação diária dos cancelamentos de contrato de plano vencidos. Vazio: o padrão do ambiente. (opcional)
# CANCELAMENTO_CONTRATO_DIARIO=

# Carga noturna do índice de pacientes da rede. Vazio: o padrão do ambiente. (opcional)
# REDE_MPI_NOTURNO=

# Vigia dos horários da enfermagem. Vazio: o padrão do ambiente. (opcional)
# ENFERMAGEM_VIGIA=

# Vigia da contenção mecânica vencida (aviso ao prescritor; "nao" desliga). Vazio: o padrão do ambiente. (opcional)
# ENFERMAGEM_VIGIA_CONTENCAO=

# Vigia dos resultados críticos. Vazio: o padrão do ambiente. (opcional)
# SADT_VIGIA_CRITICOS=

# Despertar diário das contas dormentes (sim liga em dev/ci; nao desliga). Vazio: o padrão do ambiente. (opcional)
# ACESSO_CONTAS_DORMENTES_DESPERTAR=

# Vigência dos acessos ao portal. Vazio: o padrão do ambiente. (opcional)
# PORTAL_VIGENCIA=

# Despacho por e-mail dos avisos clínicos. Vazio: o padrão do ambiente. (opcional)
# AVISO_CLINICO_EMAIL=

# Despacho das notificações por regra. Vazio: o padrão do ambiente. (opcional)
# NOTIFICACAO_DESPACHO=

# Carga diária do data mart de cada estabelecimento. Vazio: o padrão do ambiente. (opcional)
# DATAMART_CARGA_DIARIA=

# Fila de envio ao ERP corporativo. Vazio: o padrão do ambiente. (opcional)
# FILA_ERP_ENVIO=

# Entrega dos pacotes de dados aos parceiros. Vazio: o padrão do ambiente. (opcional)
# PACOTES_PARCEIRO_ENTREGA=

# Intervalo ou tamanho: vigia de mudanças das telas ao vivo. Vazio: o padrão. (opcional)
# VIGIA_MUDANCAS_MS=

# Intervalo ou tamanho: vigia do banco. Vazio: o padrão. (opcional)
# VIGIA_BANCO_MS=

# Intervalo ou tamanho: limite da transação longa no vigia do banco. Vazio: o padrão. (opcional)
# VIGIA_TRANSACAO_LIMITE_MS=

# Intervalo ou tamanho: caixa de saída. Vazio: o padrão. (opcional)
# OUTBOX_INTERVALO_MS=

# Intervalo ou tamanho: transmissor TISS. Vazio: o padrão. (opcional)
# TRANSMISSOR_TISS_INTERVALO_MS=

# Intervalo ou tamanho: entrega aos equipamentos do laboratório. Vazio: o padrão. (opcional)
# ENTREGA_EQUIPAMENTO_INTERVALO_MS=

# Intervalo ou tamanho: integrações. Vazio: o padrão. (opcional)
# INTEGRACAO_INTERVALO_MS=

# Intervalo ou tamanho: lote das integrações (fatos por ciclo). Vazio: o padrão. (opcional)
# INTEGRACAO_LOTE_FATOS=

# Intervalo ou tamanho: índice de busca. Vazio: o padrão. (opcional)
# BUSCA_VIGIA_MS=

# Intervalo ou tamanho: publicação dos catálogos. Vazio: o padrão. (opcional)
# CATALOGO_PUBLICADOR_MS=

# Intervalo ou tamanho: lotes de catálogo por ciclo. Vazio: o padrão. (opcional)
# CATALOGO_LOTES_POR_CICLO=

# Intervalo ou tamanho: janela de publicação dos catálogos. Vazio: o padrão. (opcional)
# CATALOGO_JANELA_PUBLICACAO=

# Intervalo ou tamanho: janela da leitura dos fatos contábeis. Vazio: o padrão. (opcional)
# CONTABIL_JANELA_LEITURA=

# Intervalo ou tamanho: vigência dos acessos ao portal. Vazio: o padrão. (opcional)
# PORTAL_VIGENCIA_MS=

# Intervalo ou tamanho: conferência do índice de busca. Vazio: o padrão. (opcional)
# BUSCA_CONFERENCIA_MS=

# Intervalo ou tamanho: envio agendado de relatórios. Vazio: o padrão. (opcional)
# RELATORIO_ENVIO_INTERVALO_MS=

# Lançamento automático do dia nas contas abertas (diárias e taxas). Em produção roda sempre, salvo "desligado"; em desenvolvimento e homologação só com "ligado". (opcional)
# FATURAMENTO_ROTINA_DIARIA=

# ── Observabilidade e sondas ────────────────────────────────────────────────────────────────────────────

# Coletor OpenTelemetry (métricas e rastros). (recomendada)
OTEL_EXPORTER_URL=

# Intervalo de exportação das métricas, em ms. (opcional)
# OTEL_INTERVALO_MS=

# Segredo das sondas de implantação (32+ caracteres). (OBRIGATÓRIA; SEGREDO; gere com: openssl rand -hex 32)
SONDA_TOKEN=<gerar>

# Usuário técnico de sonda (sem acesso a paciente). (recomendada)
SONDA_LOGIN=<preencher>

# Senha do usuário técnico de sonda. (recomendada; SEGREDO)
SONDA_SENHA=<gerar>

# Identificação da versão que o pacote promete (gravada pelo instalador). (recomendada)
SONDA_VERSAO_ESPERADA=

# Chaves de liberação que podem estar ligadas (lista; prefixo.* vale para o prefixo; todas; todas-exceto:<lista>; nenhuma). Vazio: o padrão da liberação full na instalação (todas, menos as que o liberacao:ligar-tudo não liga sem decisão do dono). (opcional)
# IMPLANTACAO_CHAVES_ESPERADAS=

# ── Caminhos de dados do pacote ─────────────────────────────────────────────────────────────────────────

# Pasta das imagens de origem lidas pelo conector (somente leitura). Vazio: a do pacote. (opcional)
# CONECTOR_ORIGENS_DIR=

# Pasta dos arquivos do data mart (um SQLite por estabelecimento). Vazio: .tmp/data-mart sob a pasta do serviço. (opcional)
# DATA_MART_DIR=

# Pasta dos logs de execução do conector (worker e serviço), lida pela tela Carga e sincronismo. Vazio: a do pacote. (opcional)
# CONECTOR_LOG_DIR=

# Pasta das ferramentas do pacote usadas pelo painel da plataforma (criar cliente). Vazio: a do pacote. (opcional)
# SGH_RAIZ_REPOSITORIO=

# Resumo homologado da estrutura do banco, conferido pela fumaça da implantação. Vazio: o do pacote. (opcional)
# ESTRUTURA_HOMOLOGADA=

# Pasta ou arquivo: relatórios do ensaio da versão 5 do banco. Vazio: o do pacote. (opcional)
