          },
          "opcoes": [
            {
              "indice": 0,
              "texto": "Colher lactato arterial sérico (imediato)",
              "idResposta": 1657,
              "codigo": 1039,
              "origem": "id-resposta"
            },
            {
              "indice": 1,
              "texto": "Laboratório deve entregar o resultado em até 20 minutos",
              "idResposta": 1658,
              "codigo": 1040,
              "origem": "id-resposta"
            },
            {
              "indice": 2,
              "texto": "Colher duas hemoculturas em sítios diferentes + RX tórax + sumário de urina + exames laboratoriais de rotina (Hemograma, Na, K, Ur, Cr, TGO, TGP, BT, Coagulograma, etc)",
              "idResposta": 1659,
              "codigo": 1041,
              "origem": "id-resposta"
            },
            {
              "indice": 3,
              "texto": "Administrar antimicrobiano intravenoso adequado (imediatamente após a coleta das hemoculturas)",
              "idResposta": 1660,
              "codigo": 1042,
              "origem": "id-resposta"
            },
            {
              "indice": 4,
              "texto": "Se persistência de hipotensão, após administração de cristalóides, iniciar Noradrenalina.",
              "idResposta": 1661,
              "codigo": 1043,
              "origem": "id-resposta"
            },
            {
              "indice": 5,
              "texto": "Forneça pelo menos 500 ml de fluidos IV na primeira hora e considere até 30 ml/kg de ressuscitação volêmica se houver lactato (maior ou igual a 2 x valor normal) e hipotensão (Cristalóide de escolha é o Ringer, em caso de falta, SF a 0,9%)",
              "idResposta": 1662,
              "codigo": 1044,
              "origem": "id-resposta"
            }
          ],
