            "tamanhoFonte": 8
          },
          "opcoes": [
            {
              "indice": 0,
              "texto": "Estado emocional ou comportamentos que interfiram, negativamente, no tratamento, seguimento ou adesão.",
              "idResposta": 3696,
              "codigo": 2325,
              "origem": "id-resposta"
            },
            {
              "indice": 1,
              "texto": "Disfunção emocional, cognitiva e/ou comportamental que interfira no enfrentamento da doença, do tratamento e na adaptação à rotina hospitalar.",
              "idResposta": 3697,
              "codigo": 2326,
              "origem": "id-resposta"
            },
            {
              "indice": 2,
              "texto": "Reação psicológica inadequada ou sintomas psiquiátricos.",
              "idResposta": 3698,
              "codigo": 2327,
              "origem": "id-resposta"
            },
            {
              "indice": 3,
              "texto": "Dificuldade para lidar com um diagnóstico de uma doença ameaçadora da vida ou com o diagnóstico de uma doença ameaçadora da vida ou com processo de finitude e morte.",
              "idResposta": 3699,
              "codigo": 2328,
              "origem": "id-resposta"
            },
            {
              "indice": 4,
              "texto": "Necessidade de desenvolver estratégias adaptativas para lidar com o diagnóstico ou com limitações e sequelas relacionadas ao adoecimento.",
              "idResposta": 3700,
              "codigo": 2329,
              "origem": "id-resposta"
            },
            {
              "indice": 5,
              "texto": "Outras situações, relacionadas ao processo de saúde e doença que ocasionaram a demanda de internação e que envolvem o bem-estar psicológico e emocional do usuário, e seus familiares/cuidadores e da equipe.",
              "idResposta": 3701,
              "codigo": 2330,
              "origem": "id-resposta"
            }
          ],
