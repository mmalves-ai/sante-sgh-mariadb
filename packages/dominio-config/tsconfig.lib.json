{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@sgh/contratos": ["../contratos/dist/index.d.ts"],
      "@sgh/contratos/regras-suprimentos": ["../contratos/dist/suprimentos/regras/index.d.ts"],
      "@sgh/contratos/regras-faturamento": ["../contratos/dist/faturamento/regras/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
