{
  "uid": "sgh-tecnico",
  "title": "Técnico",
  "description": "Saúde do sistema (M09): latência e erros por rota da API, consultas ao Firebird, serviços (Gotenberg, S3) e SLOs.",
  "tags": ["sgh", "m09"],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API p95 (5 min)",
      "description": "SLO provisório: p95 < 500 ms (meta definitiva na homologação, M36).",
      "datasource": {
        "type": "prometheus",
        "uid": "sgh-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sgh_http_duracao_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erros 5xx (5 min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "sgh-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "sum(rate(sgh_http_duracao_seconds_count{classe=\"5xx\"}[5m])) / clamp_min(sum(rate(sgh_http_duracao_seconds_count[5m])), 1e-9)"
        }
      ]
    },
