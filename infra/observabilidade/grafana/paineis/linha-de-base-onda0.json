    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU do servidor do banco (antes × depois)",
      "description": "Uso de CPU do servidor do Firebird; a série \"antes\" é a mesma janela deslocada pelo período de comparação (linha de base da onda).",
      "datasource": {
        "type": "prometheus",
        "uid": "sgh-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$servidor_banco\"}[5m]))",
          "legendFormat": "agora"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$servidor_banco\"}[5m] offset $comparar))",
          "legendFormat": "antes"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disco do servidor do banco: ocupação e espera de E/S",
      "description": "Ocupação do volume do banco e o tempo de E/S (antes × depois).",
      "datasource": {
        "type": "prometheus",
        "uid": "sgh-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "1 - max(node_filesystem_avail_bytes{instance=~\"$servidor_banco\",mountpoint=~\"$volume_banco\"} / node_filesystem_size_bytes{instance=~\"$servidor_banco\",mountpoint=~\"$volume_banco\"})",
          "legendFormat": "ocupação"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "sum(rate(node_disk_io_time_seconds_total{instance=~\"$servidor_banco\"}[5m]))",
          "legendFormat": "E/S agora"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sgh-prometheus"
          },
          "expr": "sum(rate(node_disk_io_time_seconds_total{instance=~\"$servidor_banco\"}[5m] offset $comparar))",
          "legendFormat": "E/S antes"
        }
      ]
    },
