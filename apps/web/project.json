{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["tipo:web", "modulo:plataforma"],
  "targets": {
    "lint": {
      "command": "eslint apps/web && stylelint \"apps/web/**/*.{css,vue}\" --allow-empty-input"
    },
    "typecheck": {
      "command": "node --max-old-space-size=8192 node_modules/vue-tsc/bin/vue-tsc.js -p apps/web/tsconfig.json --noEmit"
    },
    "test": {
      "command": "vitest run --config apps/web/vitest.config.ts"
    },
    "build": {
      "command": "vite build --config apps/web/vite.config.ts"
    },
    "serve": {
      "command": "vite --config apps/web/vite.config.ts"
    },
    "e2e": {
      "command": "playwright test -c apps/web/playwright.config.ts"
    }
  }
}
