{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["tipo:api", "modulo:plataforma"],
  "targets": {
    "lint": { "command": "eslint apps/api" },
    "typecheck": { "command": "tsc -p apps/api/tsconfig.login.json --noEmit" },
    "typecheck:pendente": { "command": "tsc -p apps/api/tsconfig.json --noEmit" },
    "test": { "command": "vitest run --config apps/api/vitest.config.ts" },
    "test:pendente": { "command": "vitest run --config apps/api/vitest.pendente.config.ts" },
    "build": {
      "command": "vite build --config apps/api/vite.config.ts",
      "inputs": [
        "production",
        "^production",
        { "runtime": "git rev-parse HEAD" },
        { "runtime": "git status --porcelain" }
      ]
    },
    "serve": {
      "dependsOn": ["build"],
      "command": "node --enable-source-maps apps/api/dist/main.js"
    }
  }
}
