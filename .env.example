# Modelo do arquivo de ambiente do projeto. Copie para .env.sante (fora do git) e preencha as senhas.
# O .env da raiz é do legado (sante-api) e nunca é lido nem alterado pelo projeto (opção B).
# Valores abaixo são fictícios; chaves de segredo ficam vazias aqui.

# Ambiente: dev | ci | homolog | treino | producao
AMBIENTE=dev

# Nome do produto, marca e domínio-base são parâmetros (DP-49). "Sante SGH" é nome provisório.
PRODUTO_NOME=Sante SGH
DOMINIO_BASE=sgh.exemplo.invalid
# Pacote de marca da rede (SVGs e cores em packages/ui/src/marca/; M07). Ausente: rede-sante (provisório, DP-9).
MARCA=rede-sante

# Processos do projeto (seção 4.11): API em 127.0.0.1:3300 e web em 127.0.0.1:5300 (porta fixa no Vite).
API_PORTA=3300
# Nível de log da API e do worker (pino): fatal | error | warn | info | debug | trace
LOG_NIVEL=info
# Intervalo do sinal de vida do worker, em milissegundos
WORKER_SINAL_MS=60000
# Entregas agendadas dos pacotes de dados aos parceiros (worker): ligadas fora de dev/ci; em dev e ci só com "ligado".
# PACOTES_PARCEIRO_ENTREGA=ligado
# Chave do pseudônimo dos campos pseudonimizados (HMAC por parceiro), no mínimo 16 bytes; em produção vem do cofre de
# segredos, nunca deste arquivo. Sem ela, o pacote com campo pseudonimizado é recusado (sem-chave-pseudonimo).
# PACOTES_PARCEIRO_CHAVE_PSEUDONIMO=
# Caminho do arquivo de ambiente (padrão: .env.sante na pasta de trabalho). Só tem efeito no ambiente do
# processo, nunca dentro deste arquivo; por isso fica comentado.
# SGH_ARQUIVO_AMBIENTE=.env.sante

# Rede padrão de localhost (ARQ-2) e estabelecimentos (ARQ-1): código curto e imutável por banco.
REDE_PADRAO=rede-exemplo
ESTABELECIMENTOS=pc,hs
# Rede pelo endereço de acesso (ARQ-2, M05): host=rede separados por ";" (o deploy troca pelo cadastro de
# redes). Também vale <rede>.<DOMINIO_BASE>. Em dev/ci, localhost/127.0.0.1/::1 = REDE_PADRAO. Endereço
# desconhecido é recusado.
# REDE_ENDERECOS=sgh.hospital.exemplo.invalid=rede-exemplo

# Estabelecimento "pc": cópia de dev compartilhada redesante-fb-pc (../banco-dev; porta 3351, só loopback)
FB_PC_HOST=127.0.0.1
FB_PC_PORTA=3351
FB_PC_BANCO=/var/lib/firebird/data/pc.fdb
FB_PC_USUARIO=SGH_DEV
FB_PC_SENHA=
FB_PC_NOME=Estabelecimento PC (exemplo)
# Conta de scripts (M04: `pnpm sgh:aplicar`, dona dos objetos SGH_; nunca a da aplicação). Senha pelo humano.
FB_PC_SCRIPTS_USUARIO=
FB_PC_SCRIPTS_SENHA=

# Estabelecimento "hs": cópia redesante-fb-hs, quando houver (HS-1; porta 3352, só loopback)
FB_HS_HOST=127.0.0.1
FB_HS_PORTA=3352
FB_HS_BANCO=/var/lib/firebird/data/hs.fdb
FB_HS_USUARIO=SGH_DEV
FB_HS_SENHA=
FB_HS_NOME=Estabelecimento HS (exemplo)
FB_HS_SCRIPTS_USUARIO=
FB_HS_SCRIPTS_SENHA=

# Núcleo do adaptador (M02). Tetos iniciais pequenos (dimensionados no M09); valores abaixo são os padrões.
# FB_POOL_TETO=4
# FB_REDE_TETO=16
# FB_POOL_ESPERA_MS=5000
# FB_CONSULTA_TEMPO_MS=15000
# FB_CONSULTA_TETO_LINHAS=1000
# FB_LOCK_TIMEOUT_S=5
# Nova tentativa dos estabelecimentos indisponíveis, em ms (M09; de 5000 a 3600000)
# FB_REVERIFICACAO_MS=60000
# Biblioteca cliente do Firebird (libfbclient2 3.0.11 do sistema; TEC-1)
# FB_CLIENTE_BIBLIOTECA=/lib/x86_64-linux-gnu/libfbclient.so.2
# Nunca SYSDBA. Exceção provisória só em dev, com host em loopback, enquanto a cópia não tiver a conta
# SGH_DEV (infra/firebird/conta-dev.sql, executado por pessoa; pendência DP-15):
# SGH_DEV_PERMITIR_SYSDBA=sim

# Serviços locais (infra/compose/dev.yml, M01), só loopback
VALKEY_URL=redis://127.0.0.1:63718
S3_ENDPOINT=http://127.0.0.1:9318
S3_ACESSO=sgh-dev
S3_SEGREDO=
GOTENBERG_URL=http://127.0.0.1:3318
SMTP_URL=smtp://127.0.0.1:1325
SESSAO_SEGREDO=
# Bloqueio da tela da sessão SINTÉTICA dos testes, em segundos (0 desliga; padrão 900). A sessão real usa
# a política do legado (TBCFGLOGIN).
SESSAO_BLOQUEIO_SEGUNDOS=900

# Acesso (M05). Combinação de senha confirmada pelo spike (docs/marcos/M05/spike-senha.md): obrigatória
# fora de dev/ci (a API não sobe sem ela). Uma de: texto-puro, sha1-senha, sha1-salt-senha,
# sha1-senha-salt, sha1-senha-maiuscula, sha1-salt-senha-maiuscula.
# ACESSO_COMBINACAO_SENHA=
# Prazo do bloqueio da porta do novo depois do limite de tentativas, em minutos (padrão 15).
# ACESSO_BLOQUEIO_PORTA_MINUTOS=15
# Troca de senha pelo novo (plano A): só com a liberação do dono (ADR 0012). Padrão: troca só no SPDATA.
# ACESSO_TROCA_SENHA_PELO_NOVO=nao
OTEL_EXPORTER_URL=
# M06 (permissões do legado e trilha dupla):
# Prefixo da estação na trilha do legado (MAQUINA_USUARIO "ESTACAO:origem"); distingue o que veio do novo.
# TRILHA_ESTACAO=SGH-WEB
# Sessão sintética (sem cookie) em AMBIENTE=dev com a cópia configurada: só com a marca explícita (o E2E
# passa sim); sem ela, o `pnpm dev` contra a cópia pede login. Em ci, sempre; fora de dev/ci, nunca.
# SESSAO_SINTETICA=sim
# Prazo do acesso de emergência (quebra de vidro), em minutos (padrão 60; teto 720).
# ACESSO_EMERGENCIA_MINUTOS=60
# Destinatário e remetente do alerta ao Auditor (fila email do worker; fora de produção, o Mailpit).
# AUDITORIA_EMAIL=auditoria@rede.invalid
# EMAIL_REMETENTE=nao-responda@rede.invalid
# ADR 0021: suporte técnico e "login como".
# Banco das contas da plataforma (padrão: o primeiro de ESTABELECIMENTOS).
# PLATAFORMA_ESTABELECIMENTO=pc
# Chave mestra (32 bytes em base64) do envelope do segredo TOTP das contas da plataforma; no cofre do deploy.
# Fora de dev/ci, sem ela o login da plataforma responde 503 (o segundo fator é obrigatório).
PLATAFORMA_CHAVE_MESTRA=
# Prazo absoluto da sessão "como", em minutos (padrão 60; teto 480). Renovar = abrir outra.
# SUPORTE_SESSAO_MINUTOS=60
# Aviso ao Auditor da rede quando o suporte abre uma sessão "como" (padrão ligado; "nao" desliga).
# SUPORTE_AVISO_AUDITOR=sim
# ADR 0022: acesso total da plataforma. Padrão de "em nome de quem gravar" (login exato do TBUSERS) por
# estabelecimento; a pessoa escolhe outro no modal. Formato: cod=LOGIN;cod2=OUTRO.
# PLATAFORMA_EM_NOME_DE=pc=LOGIN.DO.SPDATA
# ADR 0022: só em AMBIENTE=dev com ACESSO_FONTE_DEV=copia, liga as receitas das permissões do legado na tela
# "Perfis e permissões" (COMMIT no SPDATA da cópia compartilhada; padrão desligado).
# ACESSO_GESTAO_LEGADO_DEV=sim
# Só em AMBIENTE=dev: login dos usuários do SPDATA e lista de alvos pelo TBUSERS real da cópia (READ ONLY).
# Padrão: sintetica (usuários e contas sintéticos).
# ACESSO_FONTE_DEV=copia
