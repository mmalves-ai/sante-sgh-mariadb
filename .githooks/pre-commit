#!/usr/bin/env bash
# Gancho pre-commit (M00): gitleaks no que está preparado para o commit e ESLint nos arquivos alterados.
# Instalado pelo `./pnpm install` (core.hooksPath=.githooks). Imagem fixada por tag e digest; repositório só leitura.
set -euo pipefail
RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ"
# Trava de apagamento (25/11): o commit eb33b405 de um corretor levou um índice velho e apagou 11 arquivos e 1.732
# linhas de outras funções. Commit que apaga arquivo só passa com SGH_PERMITIR_APAGAR=1 (apagamento pedido de verdade).
APAGADOS="$(git diff --cached --diff-filter=D --name-only)"
if [[ -n "$APAGADOS" && "${SGH_PERMITIR_APAGAR:-}" != 1 ]]; then
  echo "pre-commit: este commit APAGA arquivos (provável índice velho levando trabalho de outro agente):" >&2
  echo "$APAGADOS" | sed 's/^/  /' >&2
  echo "Se o apagamento é da sua função, repita com SGH_PERMITIR_APAGAR=1; senão, refaça com git commit --only <seus arquivos>." >&2
  exit 1
fi
# Sintaxe dos .ts preparados (26/11): commit montado por trechos deixou o HEAD sem compilar três vezes.
node "$RAIZ/tools/obra/sintaxe-staged.cjs" || exit 1
# Em worktree (.git é um arquivo que aponta para <repo>/.git/worktrees/<nome>), o diretório git comum fica
# fora de RAIZ: monta os dois nos MESMOS caminhos, só leitura, para o git do contêiner achar o repositório.
COMUM="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
MONTAGENS=(-v "$RAIZ:$RAIZ:ro")
case "$COMUM/" in
  "$RAIZ"/*) ;;
  *) MONTAGENS+=(-v "$COMUM:$COMUM:ro") ;;
esac

# Falha fechada: qualquer erro do gitleaks (inclusive "não é um repositório git") bloqueia o commit.
mkdir -p "$RAIZ/.tmp"
LOG="$(mktemp "$RAIZ/.tmp/sgh-gitleaks.XXXXXX")"
trap 'rm -f "$LOG"' EXIT
if ! docker run --rm --name "sgh-precommit-gitleaks-$$" --network none --user "$(id -u):$(id -g)" -e HOME=/tmp \
  "${MONTAGENS[@]}" -w "$RAIZ" ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f \
  git "$RAIZ" --pre-commit --staged --config "$RAIZ/tools/verificadores/seguranca/gitleaks.toml" \
  --redact --no-banner --log-level warn 2>"$LOG"; then
  cat "$LOG" >&2
  echo "pre-commit: gitleaks encontrou segredo ou não conseguiu varrer; commit bloqueado." >&2
  exit 1
fi
if grep -q 'ERR' "$LOG"; then
  cat "$LOG" >&2
  echo "pre-commit: gitleaks não conseguiu varrer o que está preparado; commit bloqueado." >&2
  exit 1
fi
cat "$LOG" >&2

mapfile -t ARQUIVOS < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.vue' '*.js' '*.mjs')
if ((${#ARQUIVOS[@]})); then
  "$RAIZ/pnpm" exec eslint --no-warn-ignored "${ARQUIVOS[@]}"
fi
